{
   "version": "0.2.0",
   "name": "@eventail/eventail-furry-schedule-adapter",
   "description": "Publishes an eventail schedule in the Furry Schedule Schema format",
   "private": true,
   "license": "Apache-2.0",
   "type": "module",
   "engines": {
      "node": ">=26"
   },
   "devDependencies": {
      "@biomejs/biome": "^2.5.14",
      "@commitlint/cli": "^21.2.3",
      "@commitlint/config-conventional": "^21.2.3",
      "@tsconfig/node26": "^26.0.1",
      "@types/node": "^26.6.2",
      "lefthook": "^2.1.14",
      "tsx": "^4.23.15",
      "typescript": "^7.0.2"
   },
   "dependencies": {
      "@jsonapi-serde/client": "^1.3.0",
      "@taxum/core": "^1.3.1",
      "change-case": "^5.4.4",
      "logforth": "^1.3.0",
      "openid-client": "^6.8.8",
      "smol-toml": "^1.9.0",
      "stilla": "^2.2.0",
      "temporal-extra": "^1.6.0",
      "ts-pattern": "^5.9.0",
      "zod": "^4.6.5",
      "zod-temporal": "^2.2.1"
   },
   "scripts": {
      "build": "tsc -p tsconfig.build.json",
      "check": "biome check . --write",
      "config-schema": "tsx scripts/emit-config-schema.ts",
      "format": "biome format . --write",
      "start": "tsx watch --import=./src/register-crash-logger.ts ./src/index.ts",
      "test": "tsx --test 'test/**/*.test.ts'",
      "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
   },
   "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
